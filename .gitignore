# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at build time by scripts/generate-posts-cache.ts
src/data/posts-cache.json
src/data/slug-redirects.json

# semantic index — regenerated at build by scripts/generate-embeddings.ts
src/data/related.json
src/data/embeddings.f32.bin
src/data/embeddings-meta.json

# embedding model — downloaded at build from HF, not committed (too large for git)
# models/ is committed: /api/embed needs the bge-small files at runtime
# (matches how vectors/ ships for /api/semantic)
src/data/concept-passages.json
vectors/
